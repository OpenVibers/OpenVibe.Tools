# ═══════════════════════════════════════════════════════════════
# openvibe.tools gateway — Environment Configuration
# Copy to .env and fill in values.
# In production this lives at /etc/openvibe/tools.env (0600).
# ═══════════════════════════════════════════════════════════════

# Server
PORT=4001
NODE_ENV=development
BASE_URL=http://localhost:4001

# Identity provider — OpenVibe.Network (OAuth2 authorization server)
OV_NETWORK_URL=http://localhost:4000
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000

# OAuth2 client credentials (client `tools` seeded in the Network DB)
OV_OAUTH_CLIENT_ID=tools
OV_OAUTH_CLIENT_SECRET=change-me-to-the-seeded-tools-secret
# Production: https://openvibe.tools/auth/callback
OV_OAUTH_REDIRECT_URI=http://localhost:4001/auth/callback

# Cookies — production values: COOKIE_DOMAIN=.openvibe.tools, COOKIE_SECURE=true
#COOKIE_DOMAIN=.openvibe.tools
#COOKIE_SECURE=true

# OpenVibe.Media — backs Paste.OpenVibe (pastes stored under app_id 'live')
MEDIA_URL=http://127.0.0.1:4100
MEDIA_PUBLIC_URL=https://openvibe.media

# Internal API key for Network /internal/* calls (if ever needed)
INTERNAL_API_KEY=change-me-to-a-random-64-char-string
