# ═══════════════════════════════════════════════════════════════
# openvibe.tools gateway — Environment Configuration
# Copy to .env and fill in values.
# In production this lives at /etc/openvibe/tools.env (0600).
# ═══════════════════════════════════════════════════════════════

# Server
PORT=4001
NODE_ENV=development
BASE_URL=http://localhost:4001

# Identity provider — OpenVibe.Network (OAuth2 authorization server)
OV_NETWORK_URL=http://localhost:4000
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000

# OAuth2 client credentials (client `tools` seeded in the Network DB)
OV_OAUTH_CLIENT_ID=tools
OV_OAUTH_CLIENT_SECRET=change-me-to-the-seeded-tools-secret
# Production: https://openvibe.tools/auth/callback
OV_OAUTH_REDIRECT_URI=http://localhost:4001/auth/callback

# Cookies — production values: COOKIE_DOMAIN=.openvibe.tools, COOKIE_SECURE=true
#COOKIE_DOMAIN=.openvibe.tools
#COOKIE_SECURE=true

# OpenVibe.Media — backs Paste.OpenVibe (pastes stored under app_id 'live')
MEDIA_URL=http://127.0.0.1:4100
MEDIA_PUBLIC_URL=https://openvibe.media

# Net tools (optional). With an ipinfo.io token, IP lookups use ipinfo over HTTPS instead of ip-api.com's
# free tier (plain HTTP). Answers are cached either way. The Globalping token is read but no tool uses it yet.
#NET_IPINFO_TOKEN=
#NET_GLOBALPING_TOKEN=

# Service registry (the catalog's service origins); defaults to OV_NETWORK_INTERNAL_URL + /api/v1/registry/services
#OV_REGISTRY_URL=http://127.0.0.1:4000/api/v1/registry/services

# Per-actor limits (apps/_shared/actor-limits.js; every app reads the same tools.env): registry reads a
# signed-in person or third-party app may make per minute and per hour; past them 429 rate_limited with
# Retry-After. Signed-out reads keep the per-address limit only. The backstop on job submits and runs and
# the admin analytics limit have fixed numbers (README). The guard's quotas are unchanged.
#TOOLS_LIMITS_MINUTE=120
#TOOLS_LIMITS_HOUR=3000

# ── Satellites: jobs (img, audio, docs read the same tools.env) ──
#TOOLS_JOBS_CONCURRENCY=2
#TOOLS_JOBS_CONCURRENCY_AUDIO=1
#TOOLS_JOBS_MAX_ACTIVE=10
# local (default) | media — media needs OV_OAUTH_CLIENT_SECRET and the Network grants
# [tools, media.object.upload, openvibe.media] + [tools, media.object.read, openvibe.media] (namespace tools)
#TOOLS_JOB_RESULTS=local
#TOOLS_MEDIA_NAMESPACE=tools
#OV_MEDIA_INTERNAL_URL=http://127.0.0.1:4100
#OV_MEDIA_URL=https://openvibe.media
# tools.job.created|started|succeeded|failed → OpenVibe.Events (off while unset). Needs OV_OAUTH_CLIENT_SECRET and
# the Network grant [tools, events.event.publish, openvibe.events].
#EVENTS_URL=http://127.0.0.1:4300
#EVENTS_PUBLISH=off
#EVENTS_RELAY_INTERVAL_MS=2000
