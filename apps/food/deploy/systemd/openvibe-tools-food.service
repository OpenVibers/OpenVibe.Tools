[Unit]
Description=Food.OpenVibe — Budget Grocery & Meal Planning
After=network.target openvibe-tools-maps.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/openvibe.tools/apps/food
EnvironmentFile=/etc/openvibe/tools.env
# tools.env is shared by all tools services and must NOT set PORT
Environment=NODE_ENV=production
Environment=PORT=4011
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node /opt/openvibe.tools/apps/food/server/index.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/openvibe.tools/apps/food/data

[Install]
WantedBy=multi-user.target
