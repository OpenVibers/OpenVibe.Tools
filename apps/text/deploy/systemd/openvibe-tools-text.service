[Unit]
Description=Text.OpenVibe + Logo.OpenVibe — Text Generation & Logo Tools
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/openvibe.tools/apps/text
EnvironmentFile=/etc/openvibe/tools.env
# tools.env is shared by all tools services and must NOT set PORT
Environment=NODE_ENV=production
Environment=PORT=4015
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node /opt/openvibe.tools/apps/text/server/index.js
Restart=always
RestartSec=5
# Resource bounds (the host has 15 GB of RAM and 4 cores): the kernel stops this unit, not the host,
# when it runs away.
MemoryMax=768M
TasksMax=256
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/openvibe.tools/apps/text/data

[Install]
WantedBy=multi-user.target
